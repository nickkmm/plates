# Copy to .env and fill in real values. .env is gitignored.
# In production these values live in the GitHub secret ENV_FILE_B64
# and are written to /opt/plates/.env on every deploy.
POSTGRES_DB=plates
POSTGRES_USER=plates_user
POSTGRES_PASSWORD=changeme

# Web app — Claude vision (Door 2). Leave ANTHROPIC_API_KEY empty to keep
# Door 2 OFF (only the free paste-JSON Door 1 is shown). Set it to enable
# uploading a photo that the app sends to the Anthropic API.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
