# Copy to .env and fill in real values. .env is gitignored.
# In production these values live in the GitHub secret ENV_FILE_B64
# and are written to /opt/plates/.env on every deploy.
POSTGRES_DB=plates
POSTGRES_USER=plates_user
POSTGRES_PASSWORD=changeme

# --- Web authentication ---
# Secret used to sign session cookies. REQUIRED (the app won't start without it).
# Generate a fresh one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# App users as comma-separated `username:passwordhash` pairs. The hash is a
# werkzeug pbkdf2 hash (it contains ':' itself — that's fine, only the first
# ':' splits username from hash). Generate a hash with:
#   python -m app.web.hash_password 'the-password'
# Example (single user):
#   AUTH_USERS=admin:pbkdf2:sha256:600000$abc...$def...
# Example (multiple users): comma-separate them.
AUTH_USERS=

# Set to 1 in production (HTTPS) so the session cookie is marked Secure.
# Leave empty/0 for local plain-HTTP development.
COOKIE_SECURE=
